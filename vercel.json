{
  "rewrites": [
    { "source": "/api/kmb/route", "destination": "https://data.etabus.gov.hk/v1/transport/kmb/route/" },
    { "source": "/api/kmb/stops/:path*", "destination": "https://data.etabus.gov.hk/v1/transport/kmb/route-stop/:path*" },
    { "source": "/api/kmb/stop-names", "destination": "https://data.etabus.gov.hk/v1/transport/kmb/stop" },
    { "source": "/api/kmb/eta/:stop/:route/:type", "destination": "https://data.etabus.gov.hk/v1/transport/kmb/eta/:stop/:route/:type" },
    { "source": "/api/ctb/route", "destination": "https://rt.data.gov.hk/v2/transport/citybus/route/ctb" },
    { "source": "/api/ctb/stops/:path*", "destination": "https://rt.data.gov.hk/v2/transport/citybus/route-stop/ctb/:path*" },
    { "source": "/api/ctb/stop-name/:id", "destination": "https://rt.data.gov.hk/v2/transport/citybus/stop/:id" },
    { "source": "/api/ctb/eta/:stop/:route", "destination": "https://rt.data.gov.hk/v2/transport/citybus/eta/CTB/:stop/:route" },
    { "source": "/api/mtr", "destination": "https://rt.data.gov.hk/v1/transport/mtr/getSchedule.php" }
  ],
  "headers": [
    {
      "source": "/api/(kmb|ctb)/eta/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=15, stale-while-revalidate=15"
        }
      ]
    },
    {
      "source": "/api/mtr",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=15, stale-while-revalidate=15"
        }
      ]
    },
    {
      "source": "/api/(kmb|ctb)/(route|stops|stop-names|stop-name)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
